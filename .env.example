# Copy to .env and fill locally. Never commit .env.

# --- Local app ---
DATA_DIR=.data
# 0 = Modal SAM 3.1 players + ball (default). 1 = synthetic fixtures for UI-only.
USE_MOCK_TRACKS=0
SAM3_PROMPT=person
# Player track sample rate on Modal (temporal only). Spatial is full-res unless SAM3_MAX_WIDTH>0.
SAM3_FPS=8
# 0 / omit = full native width for SAM. Set e.g. 640 only if A100 VRAM forces a shrink.
SAM3_MAX_WIDTH=0
# local = run worker image/process on machine; cloudrun = gcloud run jobs execute
JOB_BACKEND=local

# --- Google Cloud Run Jobs (analysis execution) ---
# GCP_PROJECT=
# GCP_REGION=
# CLOUD_RUN_JOB_NAME=volleyball-analyze
# GOOGLE_APPLICATION_CREDENTIALS=  # or use gcloud ADC

# --- Modal (required for real AI; never install models locally) ---
# Prefer `modal token new` / `modal setup` — or set tokens if your workflow uses them:
# MODAL_TOKEN_ID=
# MODAL_TOKEN_SECRET=

# Modal app / function names (see modal_app/app.py)
MODAL_APP_NAME=volleyball-ai
MODAL_TRACK_PLAYERS_FN=track_players
# track_ball = best quality (sliding-window VballNetV1_148); track_ball_fast = speed
MODAL_TRACK_BALL_FN=track_ball
# v1_148 = best Acc@5px (~87%); v1_204 = 2nd-best (~86%)
VBALLNET_MODEL_KEY=v1_148
# Optional comparison ball trackers (soft-fail if undeployed). Set DISABLE_*=1 to skip.
# MODAL_TRACK_BALL_YOLO_FN=track_ball_yolo
# MODAL_TRACK_BALL_WASB_FN=track_ball_wasb
# WASB step=1 = paper oversampling (best AP); step=3 = faster non-overlapping
WASB_STEP=1
# DISABLE_BALL_YOLO=0
# DISABLE_BALL_WASB=0

# Court keypoints (YOLOv11n-pose from Davidsv/volley-ref-ai on Modal)
MODAL_DETECT_COURT_FN=detect_court
COURT_SAMPLE_FPS=1
COURT_MAX_FRAMES=30
COURT_CONFIDENCE=0.55

# --- OpenAI vision (court/net outline experiment; API only, no local weights) ---
# OPENAI_API_KEY=
# OPENAI_COURT_OUTLINE_MODEL=gpt-5.6
# OPENAI_NET_DETECT_MODEL=gpt-5.6
# OPENAI_NET_DETECT_MAX_SIDE=   # empty/omit = full quality; e.g. 512 to degrade
# OPENAI_IMAGE_MODEL=gpt-image-2


